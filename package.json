{
  "name": "dungeonmind-canvas",
  "version": "0.2.1",
  "description": "Measurement-driven document layouts and Konva map canvas for React",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "default": "./dist/map/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "default": "./dist/dev/index.js"
    }
  },
  "private": false,
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "./node_modules/.bin/eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "link-react": "node scripts/link-react.js"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.112",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.0.0",
    "konva": "^9.3.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.14",
    "ts-jest": "^29.0.0",
    "typescript": "^4.9.5"
  },
  "peerDependencies": {
    "konva": "^9.3.22",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-konva": "^18.2.14"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "canvas",
    "layout",
    "pagination",
    "template",
    "rendering",
    "react"
  ],
  "author": "DungeonMind",
  "license": "MIT",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "use-image": "^1.1.4",
    "uuid": "^13.0.0"
  }
}
